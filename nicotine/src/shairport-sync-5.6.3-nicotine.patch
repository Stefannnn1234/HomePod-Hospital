+static AVFrame *apac_block_to_avframe(rtsp_conn_info *conn, uint8_t *data, size_t len) {
+  ssrc_t ssrc = conn->incoming_ssrc;
+  int cch = apac_coded_channels(ssrc), bch = apac_bed_channels(ssrc);
+  if ((cch == 0) || (len == 0))
+    return NULL;
