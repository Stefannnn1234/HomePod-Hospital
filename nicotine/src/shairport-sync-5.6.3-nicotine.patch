+#ifdef CONFIG_FFMPEG
+#define HOMEPOD_APAC 1
+
+// ---- APAC (Dolby Atmos over AirPlay), decoded by an external helper process -------------------
+// The helper (apacdec) loads the codec library taken from the user's own HomePod firmware.
+// It is a separate process on purpose: it is disposable, and none of that code runs in here.
+// Protocol: we send u32 length + packet; it replies u32 frames + frames * channels float32.
+
+int ssrc_is_apac(ssrc_t ssrc) {
+  switch (ssrc) {
+  case APAC_48000_2:
+  case APAC_48000_5P1:
+  case APAC_48000_5P1P2:
+  case APAC_48000_7P1:
+  case APAC_48000_7P1P4:
+  case APAC_48000_5P1P4:
+  case APAC_48000_7P1P2:
+    return 1;
+  default:
+    return 0;
+  }
+}
+
+static int apac_coded_channels(ssrc_t ssrc) {
+  switch (ssrc) {
+  case APAC_48000_2:
+    return 2;
+  case APAC_48000_5P1:
+    return 6;
+  case APAC_48000_5P1P2:
+  case APAC_48000_7P1:
+    return 8;
+  case APAC_48000_5P1P4:
+  case APAC_48000_7P1P2:
+    return 10;
+  case APAC_48000_7P1P4:
+    return 12;
+  default:
+    return 0;
+  }
+}
+
+// what the helper's output is handed on as: stereo, or the 8-channel bed a HomePod asks a sender
+// for (5.1.2: FL FR FC LFE SL SR HL HR). The speaker processing does the rest.
+static int apac_bed_channels(ssrc_t ssrc) { return ssrc == APAC_48000_2 ? 2 : 8; }
+
+// what kind of stream this is, for the room relay (see homepod-roomcast)
+static void note_stream_class(ssrc_t ssrc) {
+  const char *path = getenv("HOMEPOD_FORMAT_FILE");
+  int cls = 0;
+  const char *word = "bed";
+  char tmp[512];
+  FILE *f;
+  if (path == NULL)
+    path = "/run/homepod/airplay.format";
+  switch (ssrc) {
+  case ALAC_44100_S16_2:
+  case ALAC_48000_S24_2:
+  case AAC_44100_F24_2:
+  case AAC_48000_F24_2:
+  case APAC_48000_2:
+    cls = 1;
+    word = "stereo";
+    break;
+  case AAC_48000_F24_5P1:
+  case AAC_48000_F24_7P1:
+  case APAC_48000_5P1:
+  case APAC_48000_7P1:
+    cls = 2;
+    word = "surround";
+    break;
+  default:
+    break;
+  }
+  snprintf(tmp, sizeof(tmp), "%s.tmp", path);
+  f = fopen(tmp, "w");
+  if (f != NULL) {
+    fprintf(f, "%d %s %s\n", cls, word, get_ssrc_name(ssrc));
+    fclose(f);
+    rename(tmp, path);
+  }
+}
+
+static const char *apac_helper_path(void) {
+  const char *s = getenv("HOMEPOD_APAC_HELPER");
+  return s ? s : "/usr/libexec/apacdec";
+}
+static const char *apac_image_path(void) {
+  const char *s = getenv("HOMEPOD_APAC_IMAGE");
+  return s ? s : "/usr/lib/nicotine/apac.img";
+}
+static int apac_available(void) {
+  static int known = -1;
+  if (known < 0) {
+    known = (access(apac_helper_path(), X_OK) == 0) && (access(apac_image_path(), R_OK) == 0);
+    if (known)
+      inform("APAC (Dolby Atmos) decoding is available: %s, %s.", apac_helper_path(),
+             apac_image_path());
+  }
+  return known;
+}
+
+static struct {
+  pthread_mutex_t lock;
+  pid_t pid;
+  int fd;
+  int channels;
+  unsigned failures;
+} apac = {PTHREAD_MUTEX_INITIALIZER, -1, -1, 0, 0};
+
+static void apac_stop_locked(void) {
+  if (apac.fd >= 0)
+    close(apac.fd);
+  apac.fd = -1;
+  if (apac.pid > 0) {
+    kill(apac.pid, SIGKILL);
+    waitpid(apac.pid, NULL, 0);
+  }
+  apac.pid = -1;
+  apac.channels = 0;
+}
+
+static int apac_start_locked(int channels) {
+  apac_stop_locked();
+  int sv[2];
+  if (socketpair(AF_UNIX, SOCK_STREAM, 0, sv) != 0)
+    return -1;
+  char chs[8];
+  snprintf(chs, sizeof(chs), "%d", channels);
+  pid_t pid = fork();
+  if (pid < 0) {
+    close(sv[0]);
+    close(sv[1]);
+    return -1;
+  }
+  if (pid == 0) {
+    dup2(sv[1], 0);
+    dup2(sv[1], 1);
+    int fd;
+    for (fd = 3; fd < 1024; fd++)
+      close(fd);
+    execl(apac_helper_path(), "apacdec", apac_image_path(), chs, (char *)NULL);
+    _exit(127);
+  }
+  close(sv[1]);
+  apac.pid = pid;
+  apac.fd = sv[0];
+  apac.channels = channels;
+  debug(1, "APAC helper started for %d channels (pid %d).", channels, (int)pid);
+  return 0;
+}
+
+static int apac_read(void *buf, size_t n, int timeout_ms) {
+  uint8_t *b = buf;
+  while (n) {
+    struct pollfd pfd = {apac.fd, POLLIN, 0};
+    if (poll(&pfd, 1, timeout_ms) <= 0)
+      return -1;
+    ssize_t r = recv(apac.fd, b, n, 0);
+    if (r <= 0)
+      return -1;
+    b += r;
+    n -= r;
+  }
+  return 0;
+}
+
+static int apac_write(const void *buf, size_t n) {
+  const uint8_t *b = buf;
+  while (n) {
+    ssize_t r = send(apac.fd, b, n, MSG_NOSIGNAL);
+    if (r <= 0)
+      return -1;
+    b += r;
+    n -= r;
+  }
+  return 0;
+}
+
+void apac_stop(void) {
+  pthread_mutex_lock(&apac.lock);
+  apac_stop_locked();
+  pthread_mutex_unlock(&apac.lock);
+}
+
+// decode one packet; returns the number of frames written to out (interleaved float), 0 on failure
+static int apac_decode(int channels, const uint8_t *data, size_t len, float *out, int max_frames) {
+  int frames = 0;
+  pthread_mutex_lock(&apac.lock);
+  if ((apac.fd < 0) || (apac.channels != channels)) {
+    if (apac.failures > 20) { // do not spin if the helper cannot run at all
+      pthread_mutex_unlock(&apac.lock);
+      return 0;
+    }
+    if (apac_start_locked(channels) != 0) {
+      apac.failures++;
+      pthread_mutex_unlock(&apac.lock);
+      return 0;
+    }
+  }
+  uint32_t l = len, n = 0;
+  // the first packet after a start waits for the helper to load the library
+  if ((apac_write(&l, 4) == 0) && (apac_write(data, len) == 0) && (apac_read(&n, 4, 3000) == 0) &&
+      (n <= (uint32_t)max_frames) &&
+      ((n == 0) || (apac_read(out, (size_t)n * channels * sizeof(float), 1000) == 0))) {
+    frames = n;
+    if (n)
+      apac.failures = 0;
+  } else {
+    debug(1, "APAC helper failed -- restarting it.");
+    apac.failures++;
+    apac_stop_locked();
+  }
+  pthread_mutex_unlock(&apac.lock);
+  return frames;
+}
+
+// Channel orders out of the decoder (from the system's own layout tables):
+//   5.1     L R C LFE Ls Rs
+//   5.1.2   L R C LFE Ls Rs Ltm Rtm          <- what a HomePod asks for; passed on as it is
+//   5.1.4   L R C LFE Ls Rs Vhl Vhr Ltr Rtr
+//   7.1     L R C LFE Ls Rs Rls Rrs
+//   7.1.2   L R C LFE Ls Rs Rls Rrs Ltm Rtm
+//   7.1.4   L R C LFE Ls Rs Rls Rrs Vhl Vhr Ltr Rtr
