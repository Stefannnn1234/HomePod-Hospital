+/*
+ * homepod_control.c -- Nicotine (HomePod Linux) glue, compiled as part of shairport.c.
+ *
+ * 1. Control FIFO (default /run/homepod/airplay.ctl, or $HOMEPOD_AIRPLAY_CTL). One command
+ *    per line, passed to Shairport Sync's own remote-control module (remote/remote.c), which
+ *    for an AirPlay 2 sender uses sendMediaRemoteCommand on the event channel:
+ *        playpause | play | pause | next | previous | stop
+ *        volume <airplay volume>      -30.0 .. 0.0, or -144 for mute; the sender's own
+ *                                     volume control follows (volume notification)
+ *    This is the interface the D-Bus / MPRIS / MQTT front ends offer upstream; none of
+ *    those is built here (no glib, no broker), hence the FIFO.
+ *
+ * 2. Volume reports. Every time the player's AirPlay volume changes (set by the sender or
+ *    through the FIFO), `/usr/sbin/homepod-audio volume-sync airplay <airplay volume>` is run
+ *    (or $HOMEPOD_VOLUME_HOOK). The speaker applies the volume itself; the samples leave
+ *    Shairport Sync at line level (general.ignore_volume_control = "yes"). Reports are
+ *    coalesced: while one hook is running, only the newest value is kept.
+ *
+ * 3. Now playing (/run/homepod/nowplaying.json, or $HOMEPOD_NOWPLAYING). A metadata-hub
+ *    watcher only flags "something changed"; a thread of our own ("homepod_np") then reads
+ *    the hub under its read lock, builds the record and, if it differs from what is on
+ *    disk, replaces the file (temp file + rename). At most two writes a second; while a
+ *    sender holds the player the thread also re-checks every 2 s (session end, drift).
+ *    The receiver never waits for this: the watcher only signals a condition variable.
+ *        {"source":"airplay|none","state":"playing|paused|stopped","title":"","artist":"",
+ *         "album":"","duration":0.0,"position":0.0,"position_at":0.0,"client":"",
+ *         "cover":"","updated":0.0}
+ *    position is in seconds as of position_at (unix time): a page runs the bar itself, so
+ *    the file is NOT rewritten as the track plays, only when the position jumps (> 1.5 s
+ *    away from where it should be) or anything else changes.
+ *    Cover art: the hub caches it as <cover_art_cache_directory>/cover-<md5>.<ext>. When
+ *    that directory is /run/homepod/cover (metadata.cover_art_cache_directory in the
+ *    config; $HOMEPOD_COVER_DIR here) the file is used as it is and the hub itself deletes
+ *    the previous one. Otherwise it is copied there and older copies are deleted, so at
+ *    most one cover stays in RAM. "cover" is then "/cover/cover-<md5>.<ext>".
+ *
+ * The now-playing code between "pure part" markers needs nothing from Shairport Sync, so
+ * a host test harness can #define HOMEPOD_NP_TEST and #include this file.
+ */
+#ifndef HOMEPOD_NP_TEST
+#include <spawn.h>
+#include <sys/wait.h>
+#include "remote/remote.h"
+
+extern char **environ;
+
+static pthread_mutex_t homepod_vol_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t homepod_vol_cond = PTHREAD_COND_INITIALIZER;
+static double homepod_vol_latest;
+static int homepod_vol_pending;
+
+void homepod_volume_changed(double airplay_volume) {
+  pthread_mutex_lock(&homepod_vol_lock);
+  homepod_vol_latest = airplay_volume;
+  homepod_vol_pending = 1;
+  pthread_cond_signal(&homepod_vol_cond);
+  pthread_mutex_unlock(&homepod_vol_lock);
+}
+
+static void *homepod_volume_thread(__attribute__((unused)) void *arg) {
+  const char *hook = getenv("HOMEPOD_VOLUME_HOOK");
+  if ((hook == NULL) || (hook[0] == '\0'))
+    hook = "/usr/sbin/homepod-audio";
+  while (1) {
+    double v;
+    pthread_mutex_lock(&homepod_vol_lock);
+    while (homepod_vol_pending == 0)
+      pthread_cond_wait(&homepod_vol_cond, &homepod_vol_lock);
+    v = homepod_vol_latest;
+    homepod_vol_pending = 0;
+    pthread_mutex_unlock(&homepod_vol_lock);
+    if (access(hook, X_OK) == 0) {
+      char value[32];
+      pid_t child;
+      snprintf(value, sizeof(value), "%.2f", v);
+      char *const argv[] = {(char *)hook, "volume-sync", "airplay", value, NULL};
+      // the hook's own output does not belong in Shairport Sync's log
+      posix_spawn_file_actions_t actions;
+      posix_spawn_file_actions_init(&actions);
+      posix_spawn_file_actions_addopen(&actions, STDOUT_FILENO, "/dev/null", O_WRONLY, 0);
+      if (posix_spawn(&child, hook, &actions, NULL, argv, environ) == 0) {
+        int status;
+        while ((waitpid(child, &status, 0) < 0) && (errno == EINTR))
+          ;
+      } else {
+        debug(1, "homepod: could not run \"%s\".", hook);
+      }
+      posix_spawn_file_actions_destroy(&actions);
+    }
+  }
+  return NULL;
+}
+
+static void homepod_control_line(char *line) {
+  double v;
+  debug(2, "homepod: control command \"%s\".", line);
+  if (strcmp(line, "playpause") == 0)
+    remote_simple_command(rcsc_play_pause);
+  else if (strcmp(line, "play") == 0)
+    remote_simple_command(rcsc_play);
+  else if (strcmp(line, "pause") == 0)
+    remote_simple_command(rcsc_pause);
+  else if (strcmp(line, "stop") == 0)
+    remote_simple_command(rcsc_stop);
+  else if (strcmp(line, "next") == 0)
+    remote_simple_command(rcsc_next_item);
+  else if (strcmp(line, "previous") == 0)
+    remote_simple_command(rcsc_previous_item);
+  else if (sscanf(line, "volume %lf", &v) == 1) {
+    if (v < -30.0)
+      v = -144.0; // mute
+    else if (v > 0.0)
+      v = 0.0;
+    remote_set_airplay_volume(v);
+  } else if (line[0] != '\0')
+    debug(1, "homepod: unknown control command \"%s\".", line);
+}
+
+static void *homepod_control_thread(__attribute__((unused)) void *arg) {
+  const char *path = getenv("HOMEPOD_AIRPLAY_CTL");
+  if ((path == NULL) || (path[0] == '\0'))
+    path = "/run/homepod/airplay.ctl";
+  while (1) {
+    // O_RDWR: the FIFO never reports end-of-file when a writer goes away.
+    // Plain read(), NOT stdio: a thread parked in fgets() holds that FILE's lock, and
+    // glibc's exit() takes every stdio lock while flushing, so the program could never
+    // exit (SIGTERM hung for ever in build 106 to 108).
+    int fd;
+    if ((mkfifo(path, 0600) != 0) && (errno != EEXIST))
+      debug(1, "homepod: can not make the control FIFO \"%s\".", path);
+    fd = open(path, O_RDWR | O_CLOEXEC);
+    if (fd < 0) {
+      sleep(5);
+      continue;
+    }
+    char line[128];
+    size_t len = 0;
+    int overlong = 0;
+    while (1) {
+      char c;
+      ssize_t n = read(fd, &c, 1);
+      if (n < 0) {
+        if (errno == EINTR)
+          continue;
+        break;
+      }
+      if (n == 0)
+        break;
+      if ((c == '\n') || (c == '\r')) {
+        line[len] = '\0';
+        if ((overlong == 0) && (len > 0))
+          homepod_control_line(line);
+        len = 0;
+        overlong = 0;
+      } else if (len < sizeof(line) - 1) {
+        line[len++] = c;
+      } else {
+        overlong = 1; // drop the whole line
+      }
+    }
+    close(fd);
+    sleep(1);
+  }
+  return NULL;
+}
+#endif /* HOMEPOD_NP_TEST */
+
+/* ======== 3. Now playing: pure part (libc only, driven by tests/np_harness.c) ======== */
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#define HP_NP_FIELD 512 /* bytes kept of each text field (cut at a character boundary) */
+#define HP_NP_JSON_MAX (6 * 5 * HP_NP_FIELD + 1024)
+
+/* what the receiver knows, as read from the hub and the connection */
+typedef struct {
+  int session;         /* a sender holds the player */
+  int player_state;    /* 0 unknown, 1 stopped, 2 paused, 3 playing (as play_status_type) */
+  int rate_paused;     /* AirPlay 2: the sender has set the play rate to 0 */
+  const char *title, *artist, *album, *client;
+  const char *cover_file; /* pathname of the cached cover, NULL/"" if none */
+  double duration;     /* seconds, 0 = unknown */
+  int position_valid;
+  double position;     /* seconds into the track, now */
+} hp_np_input;
+
+/* the record as it goes into the file */
+typedef struct {
+  char source[12], state[12];
+  char title[HP_NP_FIELD], artist[HP_NP_FIELD], album[HP_NP_FIELD], client[HP_NP_FIELD];
+  char cover[HP_NP_FIELD];
+  double duration, position, position_at, updated;
+} hp_np_record;
+
+/* copy at most dstsz-1 bytes of s, never cutting a UTF-8 sequence in two */
+static void hp_np_copy(char *dst, size_t dstsz, const char *s) {
+  size_t n;
+  if ((s == NULL) || (dstsz == 0)) {
+    if (dstsz)
+      dst[0] = '\0';
+    return;
+  }
+  n = strlen(s);
+  if (n > dstsz - 1) {
+    n = dstsz - 1;
+    while ((n > 0) && (((unsigned char)s[n] & 0xC0) == 0x80))
+      n--; /* s[n] is the first byte left out: back up to a lead byte */
+  }
+  memcpy(dst, s, n);
+  dst[n] = '\0';
+}
+
+/* length of the valid UTF-8 sequence at s (1..4), or 0 if it is not valid (RFC 3629:
+   no overlong forms, no surrogates, nothing above U+10FFFF) */
+static int hp_utf8_seq(const unsigned char *s) {
+  unsigned char c = s[0];
+  if (c < 0x80)
+    return 1;
+  if ((c >= 0xC2) && (c <= 0xDF))
+    return ((s[1] & 0xC0) == 0x80) ? 2 : 0;
+  if ((c >= 0xE0) && (c <= 0xEF)) {
+    unsigned char lo = 0x80, hi = 0xBF;
+    if (c == 0xE0)
+      lo = 0xA0;
+    else if (c == 0xED)
+      hi = 0x9F;
+    if ((s[1] < lo) || (s[1] > hi) || ((s[2] & 0xC0) != 0x80))
+      return 0;
+    return 3;
+  }
+  if ((c >= 0xF0) && (c <= 0xF4)) {
+    unsigned char lo = 0x80, hi = 0xBF;
+    if (c == 0xF0)
+      lo = 0x90;
+    else if (c == 0xF4)
+      hi = 0x8F;
+    if ((s[1] < lo) || (s[1] > hi) || ((s[2] & 0xC0) != 0x80) || ((s[3] & 0xC0) != 0x80))
+      return 0;
+    return 4;
+  }
+  return 0;
+}
+
+/* append s as a JSON string (with quotes) at out[*pos]; returns 0, or -1 if out is full.
+   Invalid UTF-8 becomes U+FFFD; control characters, U+2028 and U+2029 are escaped. */
+static int hp_json_str(char *out, size_t outsz, size_t *pos, const char *s) {
+  static const char hex[] = "0123456789abcdef";
+  const unsigned char *p = (const unsigned char *)(s ? s : "");
+  size_t o = *pos;
+#define HP_PUT(ch)                                                                                 \
+  do {                                                                                             \
+    if (o + 1 >= outsz)                                                                            \
+      return -1;                                                                                   \
+    out[o++] = (char)(ch);                                                                         \
+  } while (0)
+  HP_PUT('"');
+  while (*p) {
+    unsigned char c = *p;
+    int n;
+    if (c == '"' || c == '\\') {
+      HP_PUT('\\');
+      HP_PUT(c);
+      p++;
+    } else if (c < 0x20) {
+      HP_PUT('\\');
+      switch (c) {
+      case '\b': HP_PUT('b'); break;
+      case '\f': HP_PUT('f'); break;
+      case '\n': HP_PUT('n'); break;
+      case '\r': HP_PUT('r'); break;
+      case '\t': HP_PUT('t'); break;
+      default:
+        HP_PUT('u'); HP_PUT('0'); HP_PUT('0'); HP_PUT(hex[c >> 4]); HP_PUT(hex[c & 15]);
+      }
+      p++;
+    } else if ((n = hp_utf8_seq(p)) == 0) {
+      const char *r = "\\ufffd";
+      while (*r)
+        HP_PUT(*r++);
+      p++;
+    } else if ((n == 3) && (p[0] == 0xE2) && (p[1] == 0x80) && ((p[2] == 0xA8) || (p[2] == 0xA9))) {
+      const char *r = (p[2] == 0xA8) ? "\\u2028" : "\\u2029";
+      while (*r)
+        HP_PUT(*r++);
+      p += 3;
+    } else {
+      while (n--)
+        HP_PUT(*p++);
+    }
+  }
+  HP_PUT('"');
+  out[o] = '\0';
+  *pos = o;
+  return 0;
+#undef HP_PUT
+}
+
+static double hp_num(double v) { return (isfinite(v) && (v > 0.0)) ? v : 0.0; }
+
+/* the record as one line of JSON; returns its length or -1 */
+static int hp_np_format(const hp_np_record *r, char *out, size_t outsz) {
+  size_t pos = 0;
+  int n;
+#define HP_LIT(text)                                                                               \
+  do {                                                                                             \
+    n = snprintf(out + pos, outsz - pos, "%s", text);                                              \
+    if ((n < 0) || ((size_t)n >= outsz - pos))                                                     \
+      return -1;                                                                                   \
+    pos += (size_t)n;                                                                              \
+  } while (0)
+#define HP_STR(key, val)                                                                           \
+  do {                                                                                             \
+    HP_LIT(key);                                                                                   \
+    if (hp_json_str(out, outsz, &pos, val) != 0)                                                   \
+      return -1;                                                                                   \
+  } while (0)
+#define HP_DBL(key, val)                                                                           \
+  do {                                                                                             \
+    n = snprintf(out + pos, outsz - pos, "%s%.3f", key, hp_num(val));                              \
+    if ((n < 0) || ((size_t)n >= outsz - pos))                                                     \
+      return -1;                                                                                   \
+    pos += (size_t)n;                                                                              \
+  } while (0)
+  HP_STR("{\"source\":", r->source);
+  HP_STR(",\"state\":", r->state);
+  HP_STR(",\"title\":", r->title);
+  HP_STR(",\"artist\":", r->artist);
+  HP_STR(",\"album\":", r->album);
+  HP_DBL(",\"duration\":", r->duration);
+  HP_DBL(",\"position\":", r->position);
+  HP_DBL(",\"position_at\":", r->position_at);
+  HP_STR(",\"client\":", r->client);
+  HP_STR(",\"cover\":", r->cover);
+  HP_DBL(",\"updated\":", r->updated);
+  HP_LIT("}\n");
+  return (int)pos;
+#undef HP_LIT
+#undef HP_STR
+#undef HP_DBL
+}
+
+/* build the record for time "now" (unix seconds); cover_url is the already mapped URL */
+static void hp_np_build(hp_np_record *r, const hp_np_input *in, const char *cover_url, double now) {
+  memset(r, 0, sizeof(*r));
+  r->position_at = now;
+  if (!in->session) {
+    strcpy(r->source, "none");
+    strcpy(r->state, "stopped");
+    return;
+  }
+  strcpy(r->source, "airplay");
+  if (in->player_state == 3)
+    strcpy(r->state, in->rate_paused ? "paused" : "playing");
+  else if (in->player_state == 2)
+    strcpy(r->state, "paused");
+  else
+    strcpy(r->state, "stopped");
+  hp_np_copy(r->title, sizeof(r->title), in->title);
+  hp_np_copy(r->artist, sizeof(r->artist), in->artist);
+  hp_np_copy(r->album, sizeof(r->album), in->album);
+  hp_np_copy(r->client, sizeof(r->client), in->client);
+  hp_np_copy(r->cover, sizeof(r->cover), cover_url);
+  r->duration = hp_num(in->duration);
+  if (in->position_valid) {
+    r->position = hp_num(in->position);
+    if ((r->duration > 0.0) && (r->position > r->duration))
+      r->position = r->duration;
+  }
+}
+
+/* 1 if b says the same as a (a written earlier, b built now), 0 if b must be written */
+static int hp_np_same(const hp_np_record *a, const hp_np_record *b) {
+  double expect;
+  if (strcmp(a->source, b->source) || strcmp(a->state, b->state) || strcmp(a->title, b->title) ||
+      strcmp(a->artist, b->artist) || strcmp(a->album, b->album) ||
+      strcmp(a->client, b->client) || strcmp(a->cover, b->cover))
+    return 0;
+  if (fabs(a->duration - b->duration) > 0.5)
+    return 0;
+  expect = a->position;
+  if (strcmp(a->state, "playing") == 0)
+    expect += b->position_at - a->position_at;
+  if ((a->duration > 0.0) && (expect > a->duration))
+    expect = a->duration;
+  return fabs(expect - b->position) <= 1.5;
+}
+
+/* replace path with buf atomically; 0 or an errno value */
+static int hp_np_write(const char *path, const char *buf, size_t len) {
+  char tmp[512];
+  int fd, err = 0;
+  size_t done = 0;
+  if (snprintf(tmp, sizeof(tmp), "%s.tmp", path) >= (int)sizeof(tmp))
+    return ENAMETOOLONG;
+  fd = open(tmp, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+  if (fd < 0)
+    return errno;
+  while (done < len) {
+    ssize_t w = write(fd, buf + done, len - done);
+    if (w < 0) {
+      if (errno == EINTR)
+        continue;
+      err = errno;
+      break;
+    }
+    done += (size_t)w;
+  }
+  if ((close(fd) != 0) && (err == 0))
+    err = errno;
+  if ((err == 0) && (rename(tmp, path) != 0))
+    err = errno;
+  if (err != 0)
+    unlink(tmp);
+  return err;
+}
+
+/* remove every cover-* file in dir except keep (may be NULL) */
+static void hp_cover_prune(const char *dir, const char *keep) {
+  DIR *d = opendir(dir);
+  struct dirent *e;
+  if (d == NULL)
+    return;
+  while ((e = readdir(d)) != NULL) {
+    if ((strncmp(e->d_name, "cover-", 6) == 0) && ((keep == NULL) || strcmp(e->d_name, keep))) {
+      char p[768];
+      if (snprintf(p, sizeof(p), "%s/%s", dir, e->d_name) < (int)sizeof(p))
+        unlink(p);
+    }
+  }
+  closedir(d);
+}
+
+/* Make the hub's cached cover reachable as <coverdir>/<name> and put "/cover/<name>" in
+   url (or "" when there is no usable cover). Copies it when the hub caches elsewhere. */
+static void hp_cover_map(const char *hub_path, const char *coverdir, char *url, size_t urlsz) {
+  const char *base, *p = hub_path;
+  size_t dl = strlen(coverdir);
+  struct stat st;
+  url[0] = '\0';
+  if ((p != NULL) && (strncmp(p, "file://", 7) == 0))
+    p += 7;
+  if ((p == NULL) || (p[0] != '/'))
+    return;
+  base = strrchr(p, '/') + 1;
+  /* only names the hub makes: cover-<hex>.<ext>, nothing a page could misread */
+  if ((strncmp(base, "cover-", 6) != 0) || (strlen(base) > 64) ||
+      (strspn(base + 6, "0123456789abcdef") == 0) ||
+      (strspn(base + 6, "0123456789abcdefjpgnti.") != strlen(base + 6)))
+    return;
+  if ((stat(p, &st) != 0) || !S_ISREG(st.st_mode) || (st.st_size <= 0))
+    return;
+  if ((strncmp(p, coverdir, dl) != 0) || (p[dl] != '/') || (strchr(p + dl + 1, '/') != NULL)) {
+    /* cached somewhere else: copy it in (once), drop older copies */
+    char dst[768], tmp[800];
+    struct stat dt;
+    if (snprintf(dst, sizeof(dst), "%s/%s", coverdir, base) >= (int)sizeof(dst))
+      return;
+    if ((stat(dst, &dt) != 0) || (dt.st_size != st.st_size)) {
+      int in, out, ok = 0;
+      char buf[16384];
+      if (st.st_size > 8 * 1024 * 1024)
+        return;
+      mkdir(coverdir, 0755);
+      snprintf(tmp, sizeof(tmp), "%s/.%s.tmp", coverdir, base);
+      in = open(p, O_RDONLY | O_CLOEXEC);
+      if (in < 0)
+        return;
+      out = open(tmp, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+      if (out >= 0) {
+        ssize_t r;
+        ok = 1;
+        while ((r = read(in, buf, sizeof(buf))) != 0) {
+          if (r < 0) {
+            if (errno == EINTR)
+              continue;
+            ok = 0;
+            break;
+          }
+          if (write(out, buf, (size_t)r) != r) {
+            ok = 0;
+            break;
+          }
+        }
+        if (close(out) != 0)
+          ok = 0;
+        if (!ok || (rename(tmp, dst) != 0)) {
+          unlink(tmp);
+          ok = 0;
+        }
+      }
+      close(in);
+      if (!ok)
+        return;
+    }
+    hp_cover_prune(coverdir, base);
+  }
+  snprintf(url, urlsz, "/cover/%s", base);
+}
+/* ======== end of the pure part ======== */
+
+#ifndef HOMEPOD_NP_TEST
+/* ======== 3. Now playing: the receiver side ======== */
+#include <time.h>
+
+extern pthread_rwlock_t metadata_hub_re_lock; /* metadata/hub.c */
+
+static pthread_mutex_t homepod_np_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t homepod_np_cond;
+static int homepod_np_kick = 1; /* write the "none" record at start */
+
+/* runs on whichever thread changed the hub, with the hub's write lock held: only flag it */
+static void homepod_np_watcher(__attribute__((unused)) struct metadata_bundle *b) {
+  pthread_mutex_lock(&homepod_np_lock);
+  homepod_np_kick = 1;
+  pthread_cond_signal(&homepod_np_cond);
+  pthread_mutex_unlock(&homepod_np_lock);
+}
+
+static double homepod_np_clock(clockid_t c) {
+  struct timespec ts;
+  clock_gettime(c, &ts);
+  return (double)ts.tv_sec + ts.tv_nsec * 1e-9;
+}
+
+/* Copy what the page needs out of the hub and the playing connection. Lock order as in
+   rtsp.c / the MPRIS code: principal_conn_lock, then the hub lock (both as reader). */
+static void homepod_np_snapshot(hp_np_input *in, char (*s)[HP_NP_FIELD], char *cover_path,
+                                size_t cover_sz) {
+  memset(in, 0, sizeof(*in));
+  cover_path[0] = '\0';
+  pthread_rwlock_rdlock(&principal_conn_lock);
+  pthread_rwlock_rdlock(&metadata_hub_re_lock);
+  rtsp_conn_info *conn = principal_conn;
+  if (conn != NULL) {
+    in->session = 1;
+    in->player_state = (int)metadata_store.player_state;
+    hp_np_copy(s[0], HP_NP_FIELD, metadata_store.npi.track_name);
+    hp_np_copy(s[1], HP_NP_FIELD, metadata_store.npi.artist_name);
+    hp_np_copy(s[2], HP_NP_FIELD, metadata_store.npi.album_name);
+    hp_np_copy(s[3], HP_NP_FIELD, metadata_store.client_name);
+    hp_np_copy(cover_path, cover_sz, metadata_store.npi.cover_art_pathname);
+    in->title = s[0];
+    in->artist = s[1];
+    in->album = s[2];
+    in->client = s[3];
+    in->cover_file = cover_path;
+    if (metadata_store.npi.songtime_in_microseconds.valid)
+      in->duration = metadata_store.npi.songtime_in_microseconds.value * 1e-6;
+    int use_plist = 0;
+#ifdef CONFIG_AIRPLAY_2
+    if (conn->airplay_type == ap_2) {
+      in->rate_paused = (conn->ap2_play_enabled == 0);
+      use_plist = ((config.airplay_features & ((uint64_t)1 << 50)) != 0);
+    }
+    if (use_plist) {
+      /* as the MPRIS Position property: elapsed time when the now-playing info came,
+         plus what has been played since */
+      if (metadata_store.npi.elapsedTimeOnReceiptOfNowPlayingInfo.valid) {
+        double pos = metadata_store.npi.elapsedTimeOnReceiptOfNowPlayingInfo.value * 1e-9;
+        if (metadata_store.npi.playbackRate > 0.0) {
+          unsigned int rate =
+              (unsigned int)RATE_FROM_ENCODED_FORMAT(config.current_output_configuration);
+          if ((rate != 0) &&
+              (conn->frames_played > metadata_store.npi.framesPlayedOnReceiptOfNowPlayingInfo))
+            pos += (double)(conn->frames_played -
+                            metadata_store.npi.framesPlayedOnReceiptOfNowPlayingInfo) /
+                   rate;
+        }
+        in->position = pos;
+        in->position_valid = 1;
+      }
+    }
+#endif
+    if (!use_plist && (metadata_store.progress_string != NULL) && (conn->input_rate != 0) &&
+        (metadata_store.npi.playing_state != 2)) {
+      /* classic AirPlay: RTP timestamps of the track start and end, and of what plays now */
+      int32_t total = metadata_store.progress_last_timestamp - metadata_store.progress_first_timestamp;
+      int32_t played = metadata_store.head_rtp_timestamp - metadata_store.progress_first_timestamp;
+      if ((total > 0) && (played >= 0) && (played <= total)) {
+        in->position = (double)played / conn->input_rate;
+        in->position_valid = 1;
+        if (in->duration <= 0.0)
+          in->duration = (double)total / conn->input_rate;
+      }
+    }
+  }
+  pthread_rwlock_unlock(&metadata_hub_re_lock);
+  pthread_rwlock_unlock(&principal_conn_lock);
+}
+
+static void *homepod_np_thread(__attribute__((unused)) void *arg) {
+  const char *path = getenv("HOMEPOD_NOWPLAYING");
+  const char *coverdir = getenv("HOMEPOD_COVER_DIR");
+  static hp_np_record last, now_rec;
+  static char json[HP_NP_JSON_MAX];
+  static char strs[4][HP_NP_FIELD];
+  char cover_path[HP_NP_FIELD], cover_url[HP_NP_FIELD];
+  int have_last = 0, active = 0, failing = 0;
+  double last_write = -10.0;
+  if ((path == NULL) || (path[0] == '\0'))
+    path = "/run/homepod/nowplaying.json";
+  if ((coverdir == NULL) || (coverdir[0] == '\0'))
+    coverdir = "/run/homepod/cover";
+  while (1) {
+    hp_np_input in;
+    pthread_mutex_lock(&homepod_np_lock);
+    while (homepod_np_kick == 0) {
+      if (active) {
+        struct timespec ts;
+        clock_gettime(CLOCK_MONOTONIC, &ts);
+        ts.tv_sec += 2;
+        if (pthread_cond_timedwait(&homepod_np_cond, &homepod_np_lock, &ts) == ETIMEDOUT)
+          break;
+      } else {
+        pthread_cond_wait(&homepod_np_cond, &homepod_np_lock);
+      }
+    }
+    pthread_mutex_unlock(&homepod_np_lock);
+    /* at most two writes a second: let a burst of changes settle first */
+    double since = homepod_np_clock(CLOCK_MONOTONIC) - last_write;
+    if (since < 0.5)
+      usleep((useconds_t)((0.5 - since) * 1e6));
+    pthread_mutex_lock(&homepod_np_lock);
+    homepod_np_kick = 0;
+    pthread_mutex_unlock(&homepod_np_lock);
+
+    homepod_np_snapshot(&in, strs, cover_path, sizeof(cover_path));
+    cover_url[0] = '\0';
+    if (in.session)
+      hp_cover_map(in.cover_file, coverdir, cover_url, sizeof(cover_url));
+    hp_np_build(&now_rec, &in, cover_url, homepod_np_clock(CLOCK_REALTIME));
+    active = in.session;
+    if (have_last && hp_np_same(&last, &now_rec))
+      continue;
+    now_rec.updated = now_rec.position_at;
+    int len = hp_np_format(&now_rec, json, sizeof(json));
+    if (len < 0)
+      continue; /* cannot happen: the buffer holds the largest record */
+    int err = hp_np_write(path, json, (size_t)len);
+    if ((err == ENOENT) && (strrchr(path, '/') != NULL)) {
+      char dir[512];
+      hp_np_copy(dir, sizeof(dir), path);
+      char *slash = strrchr(dir, '/');
+      if (slash && (slash != dir)) {
+        *slash = '\0';
+        mkdir(dir, 0755);
+        err = hp_np_write(path, json, (size_t)len);
+      }
+    }
+    last_write = homepod_np_clock(CLOCK_MONOTONIC);
+    if (err == 0) {
+      last = now_rec;
+      have_last = 1;
+      failing = 0;
+    } else {
+      if (failing == 0)
+        debug(1, "homepod: can not write \"%s\": %s.", path, strerror(err));
+      failing = 1;
+      have_last = 0; /* try again at the next change or check */
+    }
+  }
+  return NULL;
+}
+#endif /* HOMEPOD_NP_TEST */
+
+#ifndef HOMEPOD_NP_TEST
+static void homepod_control_start(void) {
+  static pthread_t control_thread, volume_thread, np_thread;
+  pthread_condattr_t ca;
+  pthread_condattr_init(&ca);
+  pthread_condattr_setclock(&ca, CLOCK_MONOTONIC);
+  pthread_cond_init(&homepod_np_cond, &ca);
+  pthread_condattr_destroy(&ca);
+  add_metadata_watcher(homepod_np_watcher);
+  named_pthread_create(&np_thread, NULL, &homepod_np_thread, NULL, "homepod_np");
+  named_pthread_create(&volume_thread, NULL, &homepod_volume_thread, NULL, "homepod_vol");
+  named_pthread_create(&control_thread, NULL, &homepod_control_thread, NULL, "homepod_ctl");
+}
+#endif
