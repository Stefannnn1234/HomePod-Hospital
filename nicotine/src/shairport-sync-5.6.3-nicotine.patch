+    float *d = o + (size_t)i * bch;
+    if (bch == 2) {
+      d[0] = s[0];
+      d[1] = s[1];
+      continue;
+    }
+    d[0] = s[0]; d[1] = s[1]; d[2] = s[2]; d[3] = s[3];
+    d[4] = s[4]; d[5] = s[5]; d[6] = 0.0f; d[7] = 0.0f;
+    switch (ssrc) {
+    case APAC_48000_5P1P2:
+      d[6] = s[6]; d[7] = s[7];
+      break;
+    case APAC_48000_5P1P4:
+      d[6] = h * (s[6] + s[8]); d[7] = h * (s[7] + s[9]);
+      break;
+    case APAC_48000_7P1:
+      d[4] = h * (s[4] + s[6]); d[5] = h * (s[5] + s[7]);
+      break;
+    case APAC_48000_7P1P2:
+      d[4] = h * (s[4] + s[6]); d[5] = h * (s[5] + s[7]);
+      d[6] = s[8]; d[7] = s[9];
+      break;
+    case APAC_48000_7P1P4:
+      d[4] = h * (s[4] + s[6]); d[5] = h * (s[5] + s[7]);
+      d[6] = h * (s[8] + s[10]); d[7] = h * (s[9] + s[11]);
+      break;
+    default: // 5.1
+      break;
+    }
+  }
