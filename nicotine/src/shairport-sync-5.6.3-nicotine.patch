+  f->nb_samples = frames;
+  f->sample_rate = 48000;
+  av_channel_layout_from_mask(&f->ch_layout,
+                              bch == 2 ? AV_CH_LAYOUT_STEREO : AV_CH_LAYOUT_5POINT1POINT2_BACK);
