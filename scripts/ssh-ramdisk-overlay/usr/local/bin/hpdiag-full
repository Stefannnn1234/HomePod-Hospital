#!/bin/sh
# hpdiag-full - one-shot intake report (runs every hpdiag tool)
# Runs on the HomePod SSH ramdisk (read-only probes only). Output: one JSON
# object between ===HPDIAG_JSON_BEGIN=== / ===HPDIAG_JSON_END===.
PATH=/usr/bin:/usr/sbin:/bin:/sbin:/usr/local/bin
export PATH
LC_ALL=C
export LC_ALL

# ---- shared helpers (duplicated in every hpdiag-* script on purpose, so each
# ---- script stays standalone and can be copied/run on its own) --------------
# Tools: the SSH ramdisk (audioOS 17.5 restore ramdisk + SSHRD overlay) has NO
# awk, tr, sort, od, strings, base64 or timeout.  Everything below uses only
# shell builtins (POSIX sh features - /bin/sh there is bash 3.2) plus sed, grep,
# head, cut and wc, all of which the ramdisk carries.  Keep it that way.
TAB=$(printf '\t')
NL='
'
UC=ABCDEFGHIJKLMNOPQRSTUVWXYZ
LC=abcdefghijklmnopqrstuvwxyz
J=""       # accumulated ,"key":value pairs for the output object
NOTES=""   # human-readable notes, joined with "; "

have() { command -v "$1" >/dev/null 2>&1; }
# ioreg wrapper: -w 0 disables line truncation so long data blobs survive.
# This ramdisk's ioreg colours its output with ANSI escapes even into a pipe
# (every value arrives as ESC[0;31m99 ... ESC[0;0m), which breaks all numeric
# and string matching, so they are stripped here.  ESC is produced with printf
# because the ramdisk's BSD sed does not understand "\x1b" (a GNU extension).
ESC=$(printf '\033')
ior() { ioreg -w 0 "$@" 2>/dev/null | sed -e "s/${ESC}\[[0-9;]*m//g"; }
# NEVER dump the whole registry with properties ("ioreg -l" / "ior -l"): on this
# ramdisk that serialises every driver's properties and kernel-panics the pod.
# Two targeted forms are allowed instead:
#   nodetree CLASS...  names only.  "ioreg -r -c CLASS" WITHOUT -l prints just
#                      the "+-o name <class ...>" lines of each matching subtree
#                      and reads no property at all.  De-duplicated by entry id.
#   ior -r [-d 1] -c CLASS -l   properties of one specific class (-d 1 = that
#                      node only, not its children).
nodetree() {
  for c in "$@"; do ior -r -c "$c"; done | grep -e '+-o ' | {
    nt_seen=$NL
    while IFS= read -r nt_l || [ -n "$nt_l" ]; do
      nt_k=${nt_l##*, id }; nt_k=${nt_k%%,*}
      case "$nt_k" in
        ''|*[!0-9A-Za-z_]*)
          case "$nt_seen" in *"$NL$nt_k$NL"*) continue ;; esac
          nt_seen="$nt_seen$nt_k$NL" ;;
        *)
          eval "nt_v=\${nt_id_$nt_k-}"
          [ -n "$nt_v" ] && continue
          eval "nt_id_$nt_k=1" ;;
      esac
      printf '%s\n' "$nt_l"
    done
  }
}
# Keep printable ASCII + newlines only, so output can never break JSON.
# (LC_ALL=C, so the bracket range is plain bytes 0x20-0x7e.)
clean() { sed -e "s/$TAB/ /g" -e 's/[^ -~]//g'; }
esc() { sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
# stdin lines -> one line, joined with "," / with a literal \n
joincomma() { sed -e ':a' -e '$!N' -e 's/\n/,/' -e 'ta'; }
joinnl() { sed -e ':a' -e '$!N' -e 's/\n/\\n/' -e 'ta'; }
# lowercase stdin (ASCII)
lower() { sed -e "y/$UC/$LC/"; }
# stdin -> one JSON string literal (newlines become \n)
json_str() { printf '"%s"' "$(clean | esc | joinnl)"; }
jstr() { printf '%s' "$1" | json_str; }
# Raw text for the app's "show raw" view, capped so SSH output stays small.
jraw() { printf '%s' "$1" | head -c "${HPDIAG_RAW_MAX:-6000}" | json_str; }
# Number if plain decimal, quoted string otherwise, nothing if empty.
jnum() {
  case "$1" in
    '') ;;
    0) printf 0 ;;
    0*|*[!0-9]*) jstr "$1" ;;
    *) printf '%s' "$1" ;;
  esac
}
# ioreg text -> key=value lines (tree art and string quotes stripped)
kvlist() {
  clean | sed -n 's/^[ |]*"\([^"]*\)" = \(.*\)$/\1=\2/p' | sed -e 's/="\([^"]*\)"$/=\1/'
}
# kvlist on stdin -> the lines whose lowercased key (text before the first "=")
# matches the ERE $1, in input order.  The match runs on a key-only copy, so
# "^...$" anchor to the key; grep -n maps the hits back to the full lines.
kvsel() {
  ks_kv=$(cat)
  [ -n "$ks_kv" ] || return 0
  ks_n=$(printf '%s\n' "$ks_kv" | sed -e 's/=.*$//' | lower | grep -n -E -e "$1" | cut -d: -f1)
  [ -n "$ks_n" ] || return 0
  printf '%s\n' "$ks_kv" | sed -n "$(printf '%s\n' "$ks_n" | sed -e 's/$/p/')"
}
# kvlist on stdin -> value of the first key matching lowercase ERE $1
pick() { kvsel "$1" | head -n 1 | sed -e 's/^[^=]*=//'; }
# like pick, but only accepts decimal / 0x-hex values; prints decimal
picknum() {
  v=$(grep -E -e '^[^=]*=(0x[0-9a-fA-F]+|[0-9]+)$' | pick "$1")
  case "$v" in 0x*) printf '%d' "$v" 2>/dev/null ;; *) printf '%s' "$v" ;; esac
}
# ioreg text -> JSON object of properties whose key matches lowercase ERE $1
props_json() {
  pj_body=$(kvlist | kvsel "$1" | {
    pj_n=0; pj_seen=$NL
    while IFS= read -r pj_l || [ -n "$pj_l" ]; do
      [ "$pj_n" -lt "${2:-80}" ] || break
      pj_k=${pj_l%%=*}; pj_v=${pj_l#*=}
      case "$pj_seen" in *"$NL$pj_k$NL"*) continue ;; esac
      pj_seen="$pj_seen$pj_k$NL"; pj_n=$((pj_n + 1))
      [ "${#pj_v}" -gt 300 ] && pj_v="$(printf '%s\n' "$pj_v" | cut -c 1-300)..."
      printf '%s\t%s\n' "$pj_k" "$pj_v"
    done
  } | esc | sed -e 's/^\([^'"$TAB"']*\)'"$TAB"'\(.*\)$/"\1":"\2"/' | joincomma)
  printf '{%s}' "$pj_body"
}
# lines -> JSON array of strings (trimmed, de-duplicated, capped at $1 lines)
lines_json() {
  lj_body=$(clean | sed -e 's/^[ |]*//' | {
    lj_n=0; lj_seen=$NL
    while IFS= read -r lj_l || [ -n "$lj_l" ]; do
      [ "$lj_n" -lt "${1:-60}" ] || break
      [ -n "$lj_l" ] || continue
      case "$lj_seen" in *"$NL$lj_l$NL"*) continue ;; esac
      lj_seen="$lj_seen$lj_l$NL"; lj_n=$((lj_n + 1))
      [ "${#lj_l}" -gt 300 ] && lj_l="$(printf '%s\n' "$lj_l" | cut -c 1-300)..."
      printf '%s\n' "$lj_l"
    done
  } | esc | sed -e 's/^.*$/"&"/' | joincomma)
  printf '[%s]' "$lj_body"
}
# ioreg node lines on stdin (from nodetree) -> JSON array of nodes whose "name <class X"
# matches lowercase ERE $1.  "matched" = a driver attached to the node.
nodes_json() {
  nj_in=$(grep -e '+-o ' | clean | esc | sed -e 's/^[ |]*+-o //')
  nj_body=""
  if [ -n "$nj_in" ]; then
    nj_n=$(printf '%s\n' "$nj_in" | sed -e 's/, id .*$//' | lower | grep -n -E -e "$1" | cut -d: -f1)
    if [ -n "$nj_n" ]; then
      nj_body=$(printf '%s\n' "$nj_in" | sed -n "$(printf '%s\n' "$nj_n" | sed -e 's/$/p/')" | {
        nj_sep=""
        while IFS= read -r nj_l || [ -n "$nj_l" ]; do
          nj_key=${nj_l%%, id *}
          nj_name=$nj_key
          case "$nj_key" in *'<class'*)
            nj_name=${nj_key%%<class*}
            while :; do case "$nj_name" in *' ') nj_name=${nj_name% } ;; *) break ;; esac; done ;;
          esac
          nj_cls=${nj_key##*<class }
          case "$nj_l" in *' matched'*|*',matched'*) nj_m=true ;; *) nj_m=false ;; esac
          printf '%s{"name":"%s","class":"%s","matched":%s}' "$nj_sep" "$nj_name" "$nj_cls" "$nj_m"
          nj_sep=,
        done
      })
    fi
  fi
  printf '[%s]' "$nj_body"
}
ncount() { printf '%s\n' "$(( $(printf '%s' "$1" | grep -o '"name":' | wc -l) ))"; }
nmatched() { printf '%s\n' "$(( $(printf '%s' "$1" | grep -o '"matched":true' | wc -l) ))"; }
# names only, as a JSON array of strings
nnames() { printf '[%s]' "$(printf '%s' "$1" | grep -o '"name":"[^"]*"' | sed -e 's/^"name"://' | joincomma)"; }
add() { [ -n "$2" ] && J="$J,\"$1\":$2"; return 0; }
note() { NOTES="${NOTES}${NOTES:+; }$1"; }
# finish <ok:true|false> <verdict>  -- print the framed JSON object and exit
finish() {
  [ -n "$NOTES" ] && add note "$(jstr "$NOTES")"
  printf '%s\n' '===HPDIAG_JSON_BEGIN==='
  printf '{"tool":"%s","ok":%s,"verdict":"%s"%s}\n' "$TOOL" "$1" "$2" "$J"
  printf '%s\n' '===HPDIAG_JSON_END==='
  exit 0
}
# sed/grep/head/cut/wc do all the parsing; if one is missing every value would
# come back silently empty, so report that instead (uses no helper that needs them).
need_tools() {
  for t in sed grep head cut wc; do
    have "$t" || { J="$J,\"error\":\"required tool '$t' not found on this ramdisk\""; finish false info; }
  done
}
need_ioreg() {
  need_tools
  have ioreg && return 0
  add error "$(jstr 'ioreg not found on this ramdisk')"
  finish false info
}
# ---- end shared helpers ------------------------------------------------------

TOOL=full
need_tools
# (no dirname on the ramdisk: strip the last path component with the shell)
case "$0" in */*) DIR=${0%/*} ;; *) DIR=. ;; esac
# One entry per tool; "sensors" is run as its mic and accel views so the app
# gets one object per subsystem.
TOOLS="partmap nand factory thermal power radio audio sensors:mic sensors:accel"

tools=""; summary=""; np=0; nw=0; nf=0; ni=0
for spec in $TOOLS; do
  t=${spec%%:*}; arg=""; name=$t
  case "$spec" in *:*) arg=${spec#*:}; name=$arg ;; esac
  if [ -x "$DIR/hpdiag-$t" ]; then cmd="$DIR/hpdiag-$t"; else cmd="hpdiag-$t"; fi
  # shellcheck disable=SC2086
  out=$("$cmd" $arg 2>/dev/null)
  # Carve the object out from between the sentinels.
  js=$(printf '%s\n' "$out" | sed -n '/^===HPDIAG_JSON_BEGIN===$/,/^===HPDIAG_JSON_END===$/p' | sed -e '1d' -e '$d')
  case "$js" in
    '{'*'}') v=$(printf '%s' "$js" | grep -o '"verdict":"[a-z]*"' | head -1 | sed -e 's/.*:"//' -e 's/"$//') ;;
    *) js="{\"tool\":\"$name\",\"ok\":false,\"verdict\":\"info\",\"error\":\"hpdiag-$t missing or produced no JSON\"}"; v=info ;;
  esac
  case "$v" in pass) np=$((np+1)) ;; warn) nw=$((nw+1)) ;; fail) nf=$((nf+1)) ;; *) v=info; ni=$((ni+1)) ;; esac
  tools="$tools${tools:+,}$js"
  summary="$summary${summary:+,}\"$name\":\"$v\""
done

# Overall: any fail -> fail, else any warn -> warn, else pass.  "info" results
# are neutral, but if nothing at all could be judged the report is a warn.
if [ "$nf" -gt 0 ]; then overall=fail
elif [ "$nw" -gt 0 ]; then overall=warn
elif [ "$np" -gt 0 ]; then overall=pass
else overall=warn; note "no tool produced a pass/warn/fail result - nothing could be verified"; fi

# Serial: IOPlatformExpertDevice first, else what hpdiag-factory carved from SysCfg.
serial=$(ior -r -d 1 -c IOPlatformExpertDevice | kvlist | pick '^ioplatformserialnumber$')
[ -n "$serial" ] || serial=$(printf '%s' "$tools" | grep -o '"serial":"[A-Z0-9]*"' | head -1 | sed -e 's/.*:"//' -e 's/"$//')
[ -n "$serial" ] && add serial "$(jstr "$serial")"
add timestamp "$(jstr "$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null)")"
add overall "\"$overall\""
add counts "{\"pass\":$np,\"warn\":$nw,\"fail\":$nf,\"info\":$ni}"
add summary "{$summary}"
add tools "[$tools]"
note "ramdisk clock may be unset; trust the Mac-side timestamp"
finish true "$overall"
