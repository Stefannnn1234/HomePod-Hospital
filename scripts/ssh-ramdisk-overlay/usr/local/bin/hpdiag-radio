#!/bin/sh
# hpdiag-radio - Wi-Fi + Bluetooth presence, MAC identity and RF calibration
# Runs on the HomePod SSH ramdisk (read-only probes only). Output: one JSON
# object between ===HPDIAG_JSON_BEGIN=== / ===HPDIAG_JSON_END===.
PATH=/usr/bin:/usr/sbin:/bin:/sbin:/usr/local/bin
export PATH
LC_ALL=C
export LC_ALL

# ---- shared helpers (duplicated in every hpdiag-* script on purpose, so each
# ---- script stays standalone and can be copied/run on its own) --------------
# Tools: the SSH ramdisk (audioOS 17.5 restore ramdisk + SSHRD overlay) has NO
# awk, tr, sort, od, strings, base64 or timeout.  Everything below uses only
# shell builtins (POSIX sh features - /bin/sh there is bash 3.2) plus sed, grep,
# head, cut and wc, all of which the ramdisk carries.  Keep it that way.
TAB=$(printf '\t')
NL='
'
UC=ABCDEFGHIJKLMNOPQRSTUVWXYZ
LC=abcdefghijklmnopqrstuvwxyz
J=""       # accumulated ,"key":value pairs for the output object
NOTES=""   # human-readable notes, joined with "; "

have() { command -v "$1" >/dev/null 2>&1; }
# ioreg wrapper: -w 0 disables line truncation so long data blobs survive.
# This ramdisk's ioreg colours its output with ANSI escapes even into a pipe
# (every value arrives as ESC[0;31m99 ... ESC[0;0m), which breaks all numeric
# and string matching, so they are stripped here.  ESC is produced with printf
# because the ramdisk's BSD sed does not understand "\x1b" (a GNU extension).
ESC=$(printf '\033')
ior() { ioreg -w 0 "$@" 2>/dev/null | sed -e "s/${ESC}\[[0-9;]*m//g"; }
# NEVER dump the whole registry with properties ("ioreg -l" / "ior -l"): on this
# ramdisk that serialises every driver's properties and kernel-panics the pod.
# Two targeted forms are allowed instead:
#   nodetree CLASS...  names only.  "ioreg -r -c CLASS" WITHOUT -l prints just
#                      the "+-o name <class ...>" lines of each matching subtree
#                      and reads no property at all.  De-duplicated by entry id.
#   ior -r [-d 1] -c CLASS -l   properties of one specific class (-d 1 = that
#                      node only, not its children).
nodetree() {
  for c in "$@"; do ior -r -c "$c"; done | grep -e '+-o ' | {
    nt_seen=$NL
    while IFS= read -r nt_l || [ -n "$nt_l" ]; do
      nt_k=${nt_l##*, id }; nt_k=${nt_k%%,*}
      case "$nt_k" in
        ''|*[!0-9A-Za-z_]*)
          case "$nt_seen" in *"$NL$nt_k$NL"*) continue ;; esac
          nt_seen="$nt_seen$nt_k$NL" ;;
        *)
          eval "nt_v=\${nt_id_$nt_k-}"
          [ -n "$nt_v" ] && continue
          eval "nt_id_$nt_k=1" ;;
      esac
      printf '%s\n' "$nt_l"
    done
  }
}
# Keep printable ASCII + newlines only, so output can never break JSON.
# (LC_ALL=C, so the bracket range is plain bytes 0x20-0x7e.)
clean() { sed -e "s/$TAB/ /g" -e 's/[^ -~]//g'; }
esc() { sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
# stdin lines -> one line, joined with "," / with a literal \n
joincomma() { sed -e ':a' -e '$!N' -e 's/\n/,/' -e 'ta'; }
joinnl() { sed -e ':a' -e '$!N' -e 's/\n/\\n/' -e 'ta'; }
# lowercase stdin (ASCII)
lower() { sed -e "y/$UC/$LC/"; }
# stdin -> one JSON string literal (newlines become \n)
json_str() { printf '"%s"' "$(clean | esc | joinnl)"; }
jstr() { printf '%s' "$1" | json_str; }
# Raw text for the app's "show raw" view, capped so SSH output stays small.
jraw() { printf '%s' "$1" | head -c "${HPDIAG_RAW_MAX:-6000}" | json_str; }
# Number if plain decimal, quoted string otherwise, nothing if empty.
jnum() {
  case "$1" in
    '') ;;
    0) printf 0 ;;
    0*|*[!0-9]*) jstr "$1" ;;
    *) printf '%s' "$1" ;;
  esac
}
# ioreg text -> key=value lines (tree art and string quotes stripped)
kvlist() {
  clean | sed -n 's/^[ |]*"\([^"]*\)" = \(.*\)$/\1=\2/p' | sed -e 's/="\([^"]*\)"$/=\1/'
}
# kvlist on stdin -> the lines whose lowercased key (text before the first "=")
# matches the ERE $1, in input order.  The match runs on a key-only copy, so
# "^...$" anchor to the key; grep -n maps the hits back to the full lines.
kvsel() {
  ks_kv=$(cat)
  [ -n "$ks_kv" ] || return 0
  ks_n=$(printf '%s\n' "$ks_kv" | sed -e 's/=.*$//' | lower | grep -n -E -e "$1" | cut -d: -f1)
  [ -n "$ks_n" ] || return 0
  printf '%s\n' "$ks_kv" | sed -n "$(printf '%s\n' "$ks_n" | sed -e 's/$/p/')"
}
# kvlist on stdin -> value of the first key matching lowercase ERE $1
pick() { kvsel "$1" | head -n 1 | sed -e 's/^[^=]*=//'; }
# like pick, but only accepts decimal / 0x-hex values; prints decimal
picknum() {
  v=$(grep -E -e '^[^=]*=(0x[0-9a-fA-F]+|[0-9]+)$' | pick "$1")
  case "$v" in 0x*) printf '%d' "$v" 2>/dev/null ;; *) printf '%s' "$v" ;; esac
}
# ioreg text -> JSON object of properties whose key matches lowercase ERE $1
props_json() {
  pj_body=$(kvlist | kvsel "$1" | {
    pj_n=0; pj_seen=$NL
    while IFS= read -r pj_l || [ -n "$pj_l" ]; do
      [ "$pj_n" -lt "${2:-80}" ] || break
      pj_k=${pj_l%%=*}; pj_v=${pj_l#*=}
      case "$pj_seen" in *"$NL$pj_k$NL"*) continue ;; esac
      pj_seen="$pj_seen$pj_k$NL"; pj_n=$((pj_n + 1))
      [ "${#pj_v}" -gt 300 ] && pj_v="$(printf '%s\n' "$pj_v" | cut -c 1-300)..."
      printf '%s\t%s\n' "$pj_k" "$pj_v"
    done
  } | esc | sed -e 's/^\([^'"$TAB"']*\)'"$TAB"'\(.*\)$/"\1":"\2"/' | joincomma)
  printf '{%s}' "$pj_body"
}
# lines -> JSON array of strings (trimmed, de-duplicated, capped at $1 lines)
lines_json() {
  lj_body=$(clean | sed -e 's/^[ |]*//' | {
    lj_n=0; lj_seen=$NL
    while IFS= read -r lj_l || [ -n "$lj_l" ]; do
      [ "$lj_n" -lt "${1:-60}" ] || break
      [ -n "$lj_l" ] || continue
      case "$lj_seen" in *"$NL$lj_l$NL"*) continue ;; esac
      lj_seen="$lj_seen$lj_l$NL"; lj_n=$((lj_n + 1))
      [ "${#lj_l}" -gt 300 ] && lj_l="$(printf '%s\n' "$lj_l" | cut -c 1-300)..."
      printf '%s\n' "$lj_l"
    done
  } | esc | sed -e 's/^.*$/"&"/' | joincomma)
  printf '[%s]' "$lj_body"
}
# ioreg node lines on stdin (from nodetree) -> JSON array of nodes whose "name <class X"
# matches lowercase ERE $1.  "matched" = a driver attached to the node.
nodes_json() {
  nj_in=$(grep -e '+-o ' | clean | esc | sed -e 's/^[ |]*+-o //')
  nj_body=""
  if [ -n "$nj_in" ]; then
    nj_n=$(printf '%s\n' "$nj_in" | sed -e 's/, id .*$//' | lower | grep -n -E -e "$1" | cut -d: -f1)
    if [ -n "$nj_n" ]; then
      nj_body=$(printf '%s\n' "$nj_in" | sed -n "$(printf '%s\n' "$nj_n" | sed -e 's/$/p/')" | {
        nj_sep=""
        while IFS= read -r nj_l || [ -n "$nj_l" ]; do
          nj_key=${nj_l%%, id *}
          nj_name=$nj_key
          case "$nj_key" in *'<class'*)
            nj_name=${nj_key%%<class*}
            while :; do case "$nj_name" in *' ') nj_name=${nj_name% } ;; *) break ;; esac; done ;;
          esac
          nj_cls=${nj_key##*<class }
          case "$nj_l" in *' matched'*|*',matched'*) nj_m=true ;; *) nj_m=false ;; esac
          printf '%s{"name":"%s","class":"%s","matched":%s}' "$nj_sep" "$nj_name" "$nj_cls" "$nj_m"
          nj_sep=,
        done
      })
    fi
  fi
  printf '[%s]' "$nj_body"
}
ncount() { printf '%s\n' "$(( $(printf '%s' "$1" | grep -o '"name":' | wc -l) ))"; }
nmatched() { printf '%s\n' "$(( $(printf '%s' "$1" | grep -o '"matched":true' | wc -l) ))"; }
# names only, as a JSON array of strings
nnames() { printf '[%s]' "$(printf '%s' "$1" | grep -o '"name":"[^"]*"' | sed -e 's/^"name"://' | joincomma)"; }
add() { [ -n "$2" ] && J="$J,\"$1\":$2"; return 0; }
note() { NOTES="${NOTES}${NOTES:+; }$1"; }
# finish <ok:true|false> <verdict>  -- print the framed JSON object and exit
finish() {
  [ -n "$NOTES" ] && add note "$(jstr "$NOTES")"
  printf '%s\n' '===HPDIAG_JSON_BEGIN==='
  printf '{"tool":"%s","ok":%s,"verdict":"%s"%s}\n' "$TOOL" "$1" "$2" "$J"
  printf '%s\n' '===HPDIAG_JSON_END==='
  exit 0
}
# sed/grep/head/cut/wc do all the parsing; if one is missing every value would
# come back silently empty, so report that instead (uses no helper that needs them).
need_tools() {
  for t in sed grep head cut wc; do
    have "$t" || { J="$J,\"error\":\"required tool '$t' not found on this ramdisk\""; finish false info; }
  done
}
need_ioreg() {
  need_tools
  have ioreg && return 0
  add error "$(jstr 'ioreg not found on this ramdisk')"
  finish false info
}
# ---- end shared helpers ------------------------------------------------------

# SysCfg helpers.  The blob is the AppleDiagnosticDataSysCfg data property; ioreg
# prints it as <hex>.  FourCC tags are stored byte-reversed ('SrNm' -> 'mNrS').
# Byte values come from the shell's own printf ("'c" = character code), so no
# external tool is involved and a missing one can never turn into an empty
# (match-everything) pattern.
hexof() {
  h=""; hx_s=$1
  while [ -n "$hx_s" ]; do
    hx_r=${hx_s#?}; hx_c=${hx_s%"$hx_r"}
    h="$h${h:+ }$(printf '%02x' "'$hx_c")"
    hx_s=$hx_r
  done
  printf '%s' "$h"
}
# stdin lines -> one line, nothing in between (the hex runs of a data property)
joinnone() { sed -e ':a' -e '$!N' -e 's/\n//' -e 'ta'; }
rev4() { printf '%s' "$1" | sed -e 's/^\(.\)\(.\)\(.\)\(.\)$/\4\3\2\1/'; }
# Sets SC_NODE (raw ioreg text) and SC_HEX ("aa bb cc ..." byte-spaced, so
# pattern matches are always byte-aligned).
syscfg_load() {
  # Stock ramdisk: the ReadOnly kext.  DIAGS kernelcache boot: the writable
  # AppleDiagnosticDataAccess kext takes its place, so try that second.
  SC_CLASS=AppleDiagnosticDataAccessReadOnly
  SC_NODE=$(ior -r -c AppleDiagnosticDataAccessReadOnly -l)
  if [ -z "$SC_NODE" ]; then
    SC_CLASS=AppleDiagnosticDataAccess
    SC_NODE=$(ior -r -c AppleDiagnosticDataAccess -l)
  fi
  SC_HEX=$(printf '%s\n' "$SC_NODE" | grep -i 'syscfg' | grep -o '<[0-9a-fA-F]*>' | sed -e 's/[<>]//g' -e 'y/ABCDEF/abcdef/' | joinnone | sed -e 's/../& /g')
  [ -n "$SC_HEX" ] || SC_HEX=$(printf '%s\n' "$SC_NODE" | grep -o '<[0-9a-fA-F]*>' | sed -e 's/[<>]//g' -e 'y/ABCDEF/abcdef/' | joinnone | sed -e 's/../& /g')
}
sc_has() {
  [ -n "$(hexof "$1")" ] || return 1
  case "$SC_HEX" in *"$(hexof "$(rev4 "$1")")"*|*"$(hexof "$1")"*) return 0 ;; esac
  return 1
}
# sc_data TAG N -> the N data bytes that follow the (reversed) tag, as plain hex
sc_data() {
  [ -n "$(hexof "$1")" ] || return 0
  printf '%s\n' "$SC_HEX" | sed -n 's/^.*'"$(hexof "$(rev4 "$1")")"' \(\([0-9a-f][0-9a-f] \)\{'"$2"'\}\).*$/\1/p' | sed -e 's/ //g'
}
# sc_blob TAG -> SB_SIZE (bytes), SB_HEX (payload, plain hex), SB_INLINE.
# Returns 1 when the tag is absent.  Layout (confirmed on a real A8 HomePod):
# a 24-byte header, then 20-byte entries.  A small value sits inline (reversed
# tag + 16 data bytes).  A large one is a "CNTB" entry: 'BTNC', reversed tag,
# size (LE32), offset from the start of the blob (LE32), ff ff ff ff.
# Only the entry table (the first 4000 bytes) is searched for the tag, so a
# tag-like byte run inside some payload can never be mistaken for an entry.
sc_blob() {
  SB_SIZE=""; SB_HEX=""; SB_INLINE=false
  sb_t=$(hexof "$(rev4 "$1")"); [ -n "$sb_t" ] || return 1
  [ -n "$SC_HEX" ] || return 1
  [ -n "$SC_HDR" ] || SC_HDR=$(printf '%s' "$SC_HEX" | cut -c 1-12000)
  sb_e=$(printf '%s\n' "$SC_HDR" | sed -n 's/^.*42 54 4e 43 '"$sb_t"' \(\([0-9a-f][0-9a-f] \)\{8\}\).*$/\1/p')
  if [ -n "$sb_e" ]; then
    # shellcheck disable=SC2086
    set -- $sb_e
    SB_SIZE=$(printf '%d' "0x$4$3$2$1" 2>/dev/null); sb_off=$(printf '%d' "0x$8$7$6$5" 2>/dev/null)
    sb_total=$(( ${#SC_HEX} / 3 ))
    case "$SB_SIZE$sb_off" in ''|*[!0-9]*) SB_SIZE=""; return 1 ;; esac
    if [ "$SB_SIZE" -lt 1 ] || [ "$SB_SIZE" -gt 8192 ] || [ $((sb_off + SB_SIZE)) -gt "$sb_total" ]; then
      SB_SIZE=""; return 1
    fi
    SB_HEX=$(printf '%s' "$SC_HEX" | cut -c $((sb_off * 3 + 1))-$(((sb_off + SB_SIZE) * 3)) | sed -e 's/ //g')
    return 0
  fi
  SB_HEX=$(printf '%s\n' "$SC_HDR" | sed -n 's/^.*'"$sb_t"' \(\([0-9a-f][0-9a-f] \)\{16\}\).*$/\1/p' | sed -e 's/ //g')
  [ -n "$SB_HEX" ] || return 1
  SB_SIZE=16; SB_INLINE=true
  return 0
}
# hex helpers for the payload sc_blob returned
# sb_word N -> the Nth little-endian 32-bit word of SB_HEX, in decimal
sb_word() {
  sb_w=$(printf '%s' "$SB_HEX" | cut -c $(($1 * 8 + 1))-$(($1 * 8 + 8)) | sed -e 's/^\(..\)\(..\)\(..\)\(..\)$/\4\3\2\1/')
  case "$sb_w" in ????????) printf '%d' "0x$sb_w" 2>/dev/null ;; esac
}
# erased / never-written flash: every byte 00 or every byte ff
sb_blank() { [ -z "$(printf '%s\n' "$SB_HEX" | sed -e 's/0//g')" ] || [ -z "$(printf '%s\n' "$SB_HEX" | sed -e 's/f//g')" ]; }
TOOL=radio
need_ioreg

# Node NAMES only for discovery (see nodetree above); the only properties read
# are the two device-tree nubs below and the SysCfg node.
DUMP=$(nodetree IOPlatformExpertDevice)
# Wi-Fi: device-tree "wlan" nub plus the AppleBCMWLAN* driver stack on top.
wnodes=$(printf '%s\n' "$DUMP" | nodes_json 'wlan|wifi|applebcmwlan')
# Bluetooth: device-tree "bluetooth" nub plus AppleBCMBT*/BT UART transport.
bnodes=$(printf '%s\n' "$DUMP" | nodes_json 'bluetooth|applebcmbt|btuart|marconi')

# MACs: iBoot copies them from SysCfg into the device tree as local-mac-address.
# Targeted by node name, that node only (-d 1): never the whole device tree.
WDT=$(ior -p IODeviceTree -r -d 1 -n wlan -l)
BDT=$(ior -p IODeviceTree -r -d 1 -n bluetooth -l)
dtmac() { # dtmac <device-tree node text> <key-ERE>
  printf '%s\n' "$1" | kvlist | pick "$2" | sed -e 's/[<> ]//g' -e 'y/ABCDEF/abcdef/'
}
fmt() { printf '%s' "$1" | sed -e 's/../&:/g' -e 's/:$//'; }
okmac() { case "$1" in 000000000000|ffffffffffff) return 1 ;; esac; [ ${#1} -eq 12 ]; }
wmac=$(dtmac "$WDT" '^local-mac-address$')
bmac=$(dtmac "$BDT" '^(local-mac-address|bluetooth-address)$')

# Compare with SysCfg WMac/BMac (6 raw bytes after each tag).
syscfg_load
swmac=$(sc_data WMac 6); sbmac=$(sc_data BMac 6)

verdict=pass; drivers=0; dt=0
one() { # one <key> <nodes> <mac> <syscfg-mac> <label>
  cnt=$(ncount "$2"); o="\"present\":false"
  if [ "$cnt" -gt 0 ]; then
    dt=$((dt+1)); o="\"present\":true"
    drv=$(printf '%s' "$2" | grep -o '"class":"AppleBCM[^"]*"' | head -1 | sed -e 's/^"class"://')
    if [ -n "$drv" ]; then o="$o,\"driver\":$drv"; drivers=$((drivers+1)); else note "$5: device-tree node only, no driver attached"; fi
  else
    note "$5: no IORegistry node"
  fi
  if okmac "$3"; then
    o="$o,\"mac\":\"$(fmt "$3")\""
    if okmac "$4"; then
      if [ "$3" = "$4" ]; then o="$o,\"matchesSysCfg\":true"
      else o="$o,\"matchesSysCfg\":false,\"sysCfgMac\":\"$(fmt "$4")\""; verdict=warn; note "$5 MAC differs from SysCfg"; fi
    fi
  elif [ -n "$3" ]; then
    o="$o,\"macRaw\":$(jstr "$3")"; verdict=warn; note "$5 MAC is blank/invalid"
  fi
  add "$1" "{$o,\"nodes\":$2}"
}
one wifi "$wnodes" "$wmac" "$swmac" "Wi-Fi"
one bt "$bnodes" "$bmac" "$sbmac" "Bluetooth"

# ---- RF calibration (the factory Connectivity.lua flow, read-only) -----------
# At the factory, DIAGS loads each unit's own RF calibration out of SysCfg:
#   Wi-Fi:     syscfg print WCAL -> file -> "wifi --send_cmd calload <file>"
#   Bluetooth: syscfg print BCAL -> "bluetooth --send_raw" HCI chunks of 230
#              bytes (vendor opcode 01 97 FD E9), gBTSections = 3
# In normal boots iBoot hands the same blobs to the drivers through the device
# tree (wlan "wifi-calibration-msf" = syscfg/WCAL, bluetooth
# "bluetooth-taurus-calibration" = syscfg/BCAL).  Nothing can be sent to the
# chips from this ramdisk, but both ends of that hand-off can be checked:
#   1. the blob exists in SysCfg and has the right container.  Both are
#      'BLOB' containers: magic, header bytes, checksum, version, section
#      count, then one 20-byte entry per section, so
#      header bytes = 20 + 20 x sections (WCAL 6 sections, BCAL 3 on a real pod)
#   2. the device-tree nub carries a copy of the same size that is not all zero
# A missing or blank blob means the radio runs uncalibrated (weak range, or a
# driver that refuses to start) - typical after a NAND swap without the unit's
# own SysCfg.  No new ioreg query is made: WDT / BDT were already read above.
dtprop() { # dtprop <device-tree node text> <exact key> -> data value as plain hex
  printf '%s\n' "$1" | kvlist | {
    while IFS= read -r dp_l || [ -n "$dp_l" ]; do
      case "$dp_l" in *=*) ;; *) continue ;; esac
      if [ "${dp_l%%=*}" = "$2" ]; then printf '%s\n' "${dp_l#*=}"; break; fi
    done
  } | sed -e 's/[<> ]//g' -e 'y/ABCDEF/abcdef/'
}
calrf() { # calrf <json key> <syscfg tag> <device-tree text> <dt property> <expected sections, 0 = any> <label>
  r_o="\"tag\":\"$2\""
  if sc_blob "$2"; then
    r_blank=false; sb_blank && r_blank=true
    r_m=""; [ "$(printf '%s' "$SB_HEX" | cut -c 1-8)" = 424c4f42 ] && r_m=BLOB
    r_hdr=$(sb_word 1); r_ver=$(sb_word 3); r_sec=$(sb_word 4)
    r_o="$r_o,\"present\":true,\"bytes\":$SB_SIZE,\"blank\":$r_blank,\"magic\":\"$r_m\""
    r_ok=false
    if [ "$r_m" = BLOB ]; then
      [ -n "$r_hdr" ] && r_o="$r_o,\"headerBytes\":$r_hdr"
      [ -n "$r_ver" ] && r_o="$r_o,\"version\":$r_ver"
      [ -n "$r_sec" ] && r_o="$r_o,\"sections\":$r_sec"
      if [ -n "$r_hdr" ] && [ -n "$r_sec" ] && [ "$r_sec" -ge 1 ] && [ "$r_sec" -le 64 ] &&
         [ "$r_hdr" -eq $((20 + 20 * r_sec)) ] && [ "$r_hdr" -lt "$SB_SIZE" ]; then
        r_ok=true
        # the section table itself (small) so the app can check each section's bounds
        r_o="$r_o,\"header\":\"$(printf '%s' "$SB_HEX" | cut -c 1-$((r_hdr * 2)))\""
      fi
    fi
    r_o="$r_o,\"containerValid\":$r_ok"
    if [ "$r_blank" = true ]; then verdict=warn; note "$6 calibration ($2) is blank in SysCfg"
    elif [ "$r_ok" = false ]; then verdict=warn; note "$6 calibration ($2) does not look like a BLOB container"
    elif [ "$5" -gt 0 ] && [ "$r_sec" -ne "$5" ]; then note "$2 has $r_sec sections (factory script expects $5)"; fi
    r_size=$SB_SIZE
  else
    r_o="$r_o,\"present\":false"; r_size=""
    verdict=warn; note "$6 calibration ($2) is missing from SysCfg - the radio will run uncalibrated"
  fi
  r_dt=$(dtprop "$3" "$4")
  if [ -n "$r_dt" ]; then
    r_n=$(( ${#r_dt} / 2 )); r_z=false
    [ -z "$(printf '%s\n' "$r_dt" | sed -e 's/0//g')" ] && r_z=true
    r_o="$r_o,\"dtProperty\":\"$4\",\"dtBytes\":$r_n,\"dtZero\":$r_z"
    if [ -n "$r_size" ]; then
      if [ "$r_dt" = "$SB_HEX" ]; then r_o="$r_o,\"dtMatches\":true"
      else
        # Reported, never judged: this comparison has not been seen on enough
        # pods to know that iBoot always passes the blob through byte-for-byte.
        r_o="$r_o,\"dtMatches\":false"
        note "$6: device-tree $4 ($r_n bytes) is not a byte copy of SysCfg $2 ($r_size bytes)"
      fi
    fi
  fi
  RFCAL="$RFCAL${RFCAL:+,}\"$1\":{$r_o}"
  return 0
}
RFCAL=""
case "$SC_HEX" in
  "67 66 43 53"*|"53 43 66 67"*)
    calrf wifi WCAL "$WDT" wifi-calibration-msf 0 "Wi-Fi"
    calrf bt BCAL "$BDT" bluetooth-taurus-calibration 3 "Bluetooth"
    add calibration "{$RFCAL}" ;;
  *) note "SysCfg not readable - RF calibration (WCAL/BCAL) not checked" ;;
esac
add raw "$(jraw "$(printf '%s\n%s\n' "$WDT" "$BDT" | grep -i -E '"(local-mac-address|bluetooth-address)" = ' | sed -e 's/^[ |]*//')")"
note "enumeration / identity / calibration-presence check only - not an RF test"

if [ "$dt" -eq 0 ]; then finish false info; fi
# A missing radio, or one driver up and the other not, is suspicious.  Both
# present without drivers just means this ramdisk does not load them.
if [ "$dt" -lt 2 ] || [ "$drivers" -eq 1 ]; then verdict=warn
elif [ "$drivers" -eq 0 ] && [ "$verdict" = pass ]; then verdict=info; fi
finish true "$verdict"
