+static bool
+usb_ecid_matches(usb_handle_t *handle) {
+	char *usb_serial_num, *ecid_str;
+	bool ret = false;
+
+	if(target_ecid == 0) {
+		return true;
+	}
+	if((usb_serial_num = get_usb_serial_number(handle)) != NULL) {
+		if((ecid_str = strstr(usb_serial_num, "ECID:")) != NULL) {
+			ret = strtoull(ecid_str + strlen("ECID:"), NULL, 16) == target_ecid;
+		}
+		free(usb_serial_num);
+	}
+	return ret;
+}
