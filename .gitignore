.build/
dist/
.swiftpm/
*.xcodeproj
xcuserdata/
.DS_Store

# SSH ramdisk overlay: third-party binaries, assembled locally (see folder README)
scripts/ssh-ramdisk-overlay/*
!scripts/ssh-ramdisk-overlay/README.md
# ...but our own diagnostic scripts in it ARE tracked (the app pushes them to the pod).
# Each folder level has to be re-included before the files inside it can be.
!scripts/ssh-ramdisk-overlay/usr/
scripts/ssh-ramdisk-overlay/usr/*
!scripts/ssh-ramdisk-overlay/usr/local/
scripts/ssh-ramdisk-overlay/usr/local/*
!scripts/ssh-ramdisk-overlay/usr/local/bin/
scripts/ssh-ramdisk-overlay/usr/local/bin/*
!scripts/ssh-ramdisk-overlay/usr/local/bin/hpdiag-*

# Generic A8 APTicket (vendored from SSHRD_Script for checkm8 boot)
scripts/apticket-0x7000.shsh

# Nicotine payload OUTPUT (the built boot files for "Boot Nicotine"): produced at
# build time (BUNDLE_NICOTINE=1) into the app bundle, or imported by the user.
# Never committed.
#
# NOTE: the lowercase build kit directory `nicotine/` IS tracked on purpose -- it
# is the source a fresh checkout builds the payload from. Do NOT re-add a bare
# `Nicotine/` rule: on a case-insensitive filesystem (default macOS) it also
# matches `nicotine/` and silently un-tracks the whole kit. The specific output
# paths below (plus .build/ and Resources/Nicotine/) already cover real artifacts.
Nicotine-*/
Nicotine-*.zip
Resources/Nicotine/
scripts/nicotine-payload/
*.img4
docs/knowledge-transfer.md
screenlog.0
build109screenlog.0
screenlog.0
*.0
build.log
screenlog.0
screenlog.0

# Python bytecode caches (e.g. nicotine/tools/asahi_firmware/__pycache__)
__pycache__/
*.pyc

# Kernel/m1n1 build tree made by nicotine/kernel/build.sh
nicotine/kernel/work/
